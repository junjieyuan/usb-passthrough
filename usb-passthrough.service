[Unit]
Description=USB input passthrough daemon (hot-plug devices into a VM)
Documentation=file:/usr/local/sbin/usb-passthrough-daemon.py
After=libvirtd.service
Wants=libvirtd.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/usb-passthrough-daemon.py
# REQUIRED — uncomment and set; example values shown are the author's.
# USB_PT_VM is a comma-separated, ORDERED list of VM names: a device is
# passed to the first running VM in order (a device lives in only one VM).
# A single VM name still works.
# Environment=USB_PT_VM=windows
# Environment=USB_PT_ALLOWED=05ac:024f,1532:0083,2dc8:3106
# Note: "idle"/empty receiver states (dongle present, device off) stay
# deliberately unconfigured — never add them to USB_PT_ALLOWED.
# Optional tuning (defaults shown; values are integer seconds/counts —
# decimal values like 1.0 are rejected at startup):
# Environment=USB_PT_SETTLE=1
# Environment=USB_PT_DEBOUNCE=1
# Environment=USB_PT_RECONCILE=30
# Environment=USB_PT_ATTACH_RETRIES=3
# Environment=USB_PT_ATTACH_RETRY_GAP=2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
